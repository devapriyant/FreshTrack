# FreshTrack Backend Environment Configuration Template
# Copy this file to .env and configure your local settings.
# NEVER commit secret credentials to source control.

PORT=5000

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=freshtrack

# JWT Secret & Expiry
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Phase 3: Reminder Scheduler Settings
# The reminder scheduler runs only while the Node.js backend process is running.
ENABLE_REMINDER_SCHEDULER=true

# Safety guard flag for integration test suite
ALLOW_INTEGRATION_TEST_DB=false
